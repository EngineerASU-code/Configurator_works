<Window x:Class="Configurator.FreeSqlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свободный ввод SQL" Width="1400" Height="900" WindowState="Maximized" MinWidth="800" MinHeight="570"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}"
        Foreground="{DynamicResource BrushText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Свободный ввод SQL" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
                <Label Content="База проекта" Target="{Binding ElementName=CmbDatabase}" Padding="0,0,0,4"
                       Foreground="{DynamicResource BrushText}"/>
                <ComboBox x:Name="CmbDatabase" MinHeight="34"
                          BorderBrush="{DynamicResource BrushTextSecondary}"
                          SelectionChanged="CmbDatabase_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid x:Name="QueryLibrary">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Локальные запросы" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Grid.Row="1">
                    <ListBox x:Name="SavedQueries" DisplayMemberPath="Name"
                             AutomationProperties.Name="Сохранённые локальные запросы"
                             Background="{DynamicResource BrushPanel}" Foreground="{DynamicResource BrushText}"
                             BorderBrush="{DynamicResource BrushBorder}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             SelectionChanged="SavedQueries_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                <Setter Property="ToolTip" Value="{Binding Name}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemSurface" Background="Transparent" BorderBrush="Transparent"
                                                    BorderThickness="3,0,0,0" Padding="6,7">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BrushHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BrushSelected}"/>
                                                    <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock x:Name="TxtLibraryState" Margin="10" TextWrapping="Wrap"
                               IsHitTestVisible="False" Foreground="{DynamicResource BrushText}"/>
                </Grid>
                <UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,0">
                    <Button x:Name="BtnOpenQuery" Content="Открыть" Margin="0,0,4,0"
                            IsEnabled="False" Click="BtnOpenQuery_Click"/>
                    <Button Content="Обновить" ToolTip="Обновить список запросов" Margin="4,0,0,0" Click="BtnRefresh_Click"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="QueryActions" Margin="0,0,0,8">
                <TextBlock x:Name="TxtCurrentQuery" Text="Новый запрос" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Label Content="Имя запроса" Target="{Binding ElementName=TxtQueryName}" Padding="0,6,0,4"
                       Foreground="{DynamicResource BrushText}"/>
                <TextBox x:Name="TxtQueryName" MaxLength="128" MinHeight="36" Padding="8,5"
                         VerticalContentAlignment="Center" Background="{DynamicResource BrushPanel}"
                         Foreground="{DynamicResource BrushText}" BorderBrush="{DynamicResource BrushTextSecondary}"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="BtnSaveQuery" Content="Сохранить новый" Margin="0,0,8,0"
                            Click="BtnSaveQuery_Click"/>
                    <Button x:Name="BtnUpdateQuery" Content="Обновить открытый" Margin="0,0,8,0"
                            IsEnabled="False" Click="BtnSaveQuery_Click"/>
                    <Button x:Name="BtnNew" Content="Новый" Click="BtnClear_Click"/>
                </WrapPanel>
            </StackPanel>
            <Grid Grid.Row="1" ClipToBounds="True">
                <TextBox x:Name="TxtSql" AcceptsReturn="True" AutomationProperties.Name="Текст SQL-запроса"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="14" Padding="12" TextWrapping="NoWrap"
                         Background="{DynamicResource BrushPanel}" Foreground="{DynamicResource BrushText}"
                         BorderBrush="{DynamicResource BrushBorder}"/>
                <TextBlock Margin="14" FontFamily="Consolas" FontSize="14" Opacity="0.65"
                           Foreground="{DynamicResource BrushText}" IsHitTestVisible="False"
                           Text="SELECT column1, column2&#x0a;FROM dbo.TableName&#x0a;WHERE condition">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtSql}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,10">
                <Button x:Name="BtnExecute" DockPanel.Dock="Right" Content="Выполнить" MinWidth="110"
                        Margin="10,0,0,0" Style="{DynamicResource BtnPrimary}" Click="BtnExecute_Click"/>
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <Border Grid.Row="3" Background="{DynamicResource BrushPanel}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                          Background="{DynamicResource BrushPanel}" Foreground="{DynamicResource BrushText}" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BrushBorder}"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
            </Border>
        </Grid>
    </Grid>
</Window>
