<UserControl x:Class="Configurator.RightPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PageButton" TargetType="Button" BasedOn="{StaticResource BtnCompact}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ColumnFilterButton" TargetType="Button" BasedOn="{StaticResource BtnCompact}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BrushBase}" Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TableTitle" Text="Выберите таблицу слева"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Просмотр и редактирование данных"
                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnResetColumnView" Content="Сбросить фильтры и сортировку"
                        Margin="0,0,8,0" ToolTip="Восстановить исходный вид выбранной таблицы">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnCompact}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ItemsSource, ElementName=DataTableGrid}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasActiveColumnView, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnToggleFields"
                        Content="Поля записи  ▼"
                        Style="{StaticResource BtnCompact}"
                        MinWidth="144"
                        ToolTip="Развернуть поля записи"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="BtnFirst" Content="⏮" ToolTip="Первая страница" AutomationProperties.Name="Первая страница" Style="{StaticResource PageButton}" Margin="0,0,5,0"/>
                    <Button x:Name="BtnPrev" Content="‹" ToolTip="Предыдущая страница" AutomationProperties.Name="Предыдущая страница" Style="{StaticResource PageButton}" Margin="0,0,8,0"/>
                    <Border Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="7" Height="32" Padding="12,0" MinWidth="100">
                        <TextBlock x:Name="PageInfo" Text="—" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrushText}" FontSize="12"/>
                    </Border>
                    <Button x:Name="BtnNext" Content="›" ToolTip="Следующая страница" AutomationProperties.Name="Следующая страница" Style="{StaticResource PageButton}" Margin="8,0,5,0"/>
                    <Button x:Name="BtnLast" Content="⏭" ToolTip="Последняя страница" AutomationProperties.Name="Последняя страница" Style="{StaticResource PageButton}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="InputPanel"
                Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" Padding="14" Margin="0,0,0,12"
                Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Поля записи" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}"/>
                    <TextBlock x:Name="FieldsEmptyHint"
                               Text="Выберите одну строку в таблице"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               FontSize="11"/>
                </Grid>
                <WrapPanel x:Name="FieldsContainer" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <DataGrid x:Name="DataTableGrid"
                      Background="{DynamicResource BrushPanel}"
                      Foreground="{DynamicResource BrushText}"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BrushBorder}"
                      VerticalGridLinesBrush="{DynamicResource BrushGridLine}"
                      HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True" AutoGenerateColumns="True" CanUserSortColumns="False"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      RowHeight="34"
                      ColumnHeaderHeight="38"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader"
                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Background" Value="{DynamicResource BrushBase}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushSelected}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

            <WrapPanel Visibility="Collapsed">
                <Button x:Name="BtnAdd" Visibility="Collapsed" Content="＋ Добавить" Style="{StaticResource BtnPrimary}" Width="124" Margin="0,0,8,0"/>
                <Button x:Name="BtnUpdate" Visibility="Collapsed" Content="Изменить" Style="{StaticResource BtnSecondary}" Width="124" Margin="0,0,8,0"/>
                <Button x:Name="BtnDuplicate" Visibility="Collapsed" Content="Дублировать" Style="{StaticResource BtnSecondary}" Width="124" Margin="0,0,8,0"/>
                <Button x:Name="BtnDelete" Visibility="Collapsed" Content="Удалить" Style="{StaticResource BtnSecondary}" Width="124" Margin="0,0,8,0"/>
            </WrapPanel>
    </Grid>
</UserControl>
