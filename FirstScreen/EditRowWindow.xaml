<Window x:Class="Configurator.EditRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить строку"
        SizeToContent="Height" MinWidth="650" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBase}"
        KeyDown="Window_KeyDown">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="BtnSave_Click"/>
    </Window.CommandBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="WindowTitle"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}"
                   Margin="0,0,0,8"/>

        <Grid Grid.Row="1" x:Name="FieldArea" Margin="0,0,0,6">
            <Viewbox StretchDirection="DownOnly" VerticalAlignment="Top">
            <UniformGrid Width="{Binding ActualWidth, ElementName=FieldArea}" x:Name="FieldsPanel" Columns="3" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
        </Viewbox>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="ValidationHint"
                   FontSize="12"
                   Foreground="#FF6B6B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="❌ Отмена"
                    Style="{StaticResource BtnSecondary}"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="💾 Сохранить"
                    Style="{StaticResource BtnSecondary}"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
