<Window x:Class="Configurator.AddRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить строку"
        Height="720" Width="1100" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBase}"
        KeyDown="Window_KeyDown">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="WindowTitle"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}"
                   Margin="0,0,0,8"/>

        <Grid Grid.Row="1" x:Name="FieldArea" Margin="0,0,0,10">
            <StackPanel x:Name="FieldsPanel"/>
        </Grid>

        <StackPanel x:Name="PageControls" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
            <Button Content="Назад" x:Name="PreviousPage" Click="PreviousPage_Click" Style="{StaticResource BtnSecondary}"/>
            <TextBlock x:Name="PageNumber" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}"/>
            <Button Content="Далее" x:Name="NextPage" Click="NextPage_Click" Style="{StaticResource BtnSecondary}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="❌ Отмена"
                    Style="{StaticResource BtnSecondary}"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnConfirm" Content="✅ Добавить"
                    Style="{StaticResource BtnPrimary}"
                    Click="BtnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
