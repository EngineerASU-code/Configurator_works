<Window x:Class="Configurator.TableFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтр и сортировка" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushBase}">
    <StackPanel Margin="22">
        <TextBlock x:Name="ColumnTitle" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
        <TextBlock Text="Условие фильтра" Margin="0,16,0,5" Foreground="{DynamicResource BrushText}"/>
        <ComboBox x:Name="CmbOperator" TextSearch.TextPath="Label" SelectedValuePath="Key"
                  SelectionChanged="CmbOperator_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox x:Name="TxtValue" Margin="0,8,0,0" MinHeight="34"
                 ToolTip="Значение фильтра" AutomationProperties.Name="Значение фильтра"/>
        <TextBlock Text="Сортировка" Margin="0,16,0,5" Foreground="{DynamicResource BrushText}"/>
        <ComboBox x:Name="CmbSort" AutomationProperties.Name="Сортировка"/>
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushText}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сбросить столбец" Margin="0,0,8,0" Click="BtnClear_Click"/>
            <Button Content="Отмена" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Применить" IsDefault="True" Click="BtnApply_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
