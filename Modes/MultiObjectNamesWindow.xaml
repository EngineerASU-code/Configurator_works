<Window x:Class="Configurator.MultiObjectNamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Несколько новых объектов" Width="620" Height="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Создание нескольких объектов" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,10" Text="Введите имена объектов — по одному в строке. Остальные поля получат значения по умолчанию, NULL или автоматически назначаемые значения (Record, PLC и т. п.)." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
        <StackPanel Grid.Row="2" Margin="0,0,0,10"><TextBlock Text="PLC для создаваемых объектов" Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/><ComboBox x:Name="PlcCombo" Height="32" DisplayMemberPath="Title" SelectedValuePath="Key"/></StackPanel>
        <TextBox x:Name="NamesText" Grid.Row="3" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontSize="13" Padding="8"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Width="100" Height="32" Style="{StaticResource BtnSecondary}" Click="Cancel_Click"/>
            <Button Content="Создать" Width="120" Height="32" Margin="8,0,0,0" Style="{StaticResource BtnPrimary}" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
