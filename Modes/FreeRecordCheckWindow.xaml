<Window x:Class="Configurator.FreeRecordCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверить Record" Width="760" Height="540"
        MinWidth="620" MinHeight="410" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Проверить Record" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}"/>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,14,0,16">
            <StackPanel Margin="0,0,8,0">
                <Label Content="База" Target="{Binding ElementName=CmbDatabase}" Foreground="{DynamicResource BrushText}"/>
                <ComboBox x:Name="CmbDatabase" Height="34" SelectionChanged="CmbDatabase_SelectionChanged"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <Label Content="PLC" Target="{Binding ElementName=CmbPlc}" Foreground="{DynamicResource BrushText}"/>
                <ComboBox x:Name="CmbPlc" Height="34" TextSearch.TextPath="Label" SelectionChanged="CmbPlc_SelectionChanged" IsEnabled="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <Label Content="Класс" Target="{Binding ElementName=CmbClass}" Foreground="{DynamicResource BrushText}"/>
                <ComboBox x:Name="CmbClass" Height="34" SelectionChanged="CmbClass_SelectionChanged" IsEnabled="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Class.Title}" ToolTip="{Binding Class.TableName}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </UniformGrid>

        <Border Grid.Row="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="9">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtResultHeader" Text="Результат проверки" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtResult" FontSize="18" TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="BtnCheck" Content="Проверить" Style="{StaticResource BtnPrimary}" Width="120" Margin="8,0,0,0"
                        Click="Check_Click" IsEnabled="False" IsDefault="True"/>
                <Button Content="Закрыть" Width="100" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextSecondary}"/>
        </DockPanel>
    </Grid>
</Window>
