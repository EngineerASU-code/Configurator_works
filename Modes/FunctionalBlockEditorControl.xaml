<UserControl x:Class="Configurator.FunctionalBlockEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBase}">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Padding="14" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Функциональные блоки" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}" Margin="0,0,0,10" />
                    <Button x:Name="AddButton" Content="＋  Новый блок" Height="36" Margin="0,0,0,10"
                            Style="{StaticResource BtnPrimary}" Click="Add_Click" />
                </StackPanel>
                <ListBox x:Name="BlocksList" DisplayMemberPath="Name" SelectionChanged="BlocksList_SelectionChanged"
                         BorderBrush="{DynamicResource BrushBorder}" Background="{DynamicResource BrushBase}"
                         Foreground="{DynamicResource BrushText}" />
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Padding="18" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="EmptyState" Grid.Row="0" Text="Выберите блок или создайте новый."
                           FontSize="17" Foreground="{DynamicResource BrushTextSecondary}" />
                <StackPanel x:Name="EditorPanel" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed">
                    <TextBlock Text="Имя блока" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBox x:Name="NameBox" Height="34" Margin="0,5,0,12" Padding="8,4" TextChanged="Editor_TextChanged" />
                    <TextBlock Text="Описание" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBox x:Name="DescriptionBox" Height="62" Margin="0,5,0,12" Padding="8,5"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged" />
                    <TextBlock Text="Интерфейс (текстовое описание)" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBox x:Name="InterfaceBox" Height="94" Margin="0,5,0,12" Padding="8,5"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextChanged="Editor_TextChanged" />
                    <TextBlock Text="Текст реализации" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBox x:Name="SourceBox" MinHeight="180" Margin="0,5,0,12" Padding="8,5"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" TextChanged="Editor_TextChanged" />
                    <TextBlock Text="Текст хранится как авторский исходник. Экспорт в формат Siemens не выполняется."
                               Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextSecondary}" />
                <StackPanel x:Name="ActionPanel" Grid.Row="5" Orientation="Horizontal"
                            HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button x:Name="DuplicateButton" Content="Дублировать" MinWidth="112" Height="34"
                            Margin="0,0,8,0" Style="{StaticResource BtnSecondary}" Click="Duplicate_Click" />
                    <Button x:Name="DeleteButton" Content="Удалить" MinWidth="86" Height="34"
                            Margin="0,0,8,0" Style="{StaticResource BtnSecondary}" Click="Delete_Click" />
                    <Button x:Name="SaveButton" Content="Сохранить" MinWidth="108" Height="34"
                            Style="{StaticResource BtnPrimary}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
