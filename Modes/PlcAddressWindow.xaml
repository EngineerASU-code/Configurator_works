<Window x:Class="Configurator.PlcAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карта адресов PLC" Width="1180" Height="790" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <DockPanel Margin="22">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Label VerticalAlignment="Center" Content="Проект" Target="{Binding ElementName=Project}"/>
            <ComboBox x:Name="Project" Width="220" Height="34" Margin="0" VerticalContentAlignment="Center" DisplayMemberPath="Name" SelectionChanged="SelectProject"/>
            <Button x:Name="Browse" Content="Офлайн-проект" Margin="6,0,12,0" VerticalAlignment="Center" Click="BrowseProject"/>
            <Label VerticalAlignment="Center" Content="PLC" Target="{Binding ElementName=Plc}"/>
            <ComboBox x:Name="Plc" Width="95" Height="34" Margin="0" VerticalContentAlignment="Center" IsEnabled="False" SelectionChanged="SelectPlc"/>
            <Label VerticalAlignment="Center" Content="Тип сигнала" Target="{Binding ElementName=SignalType}"/>
            <ComboBox x:Name="SignalType" Height="34" SelectedIndex="0" IsEnabled="{Binding IsEnabled, ElementName=Filter}" SelectionChanged="SelectFilter">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="AI"/>
                <ComboBoxItem Content="DI"/>
                <ComboBoxItem Content="DO"/>
                <ComboBoxItem Content="AO"/>
            </ComboBox>
            <Label VerticalAlignment="Center" Content="Показать байты" Margin="16,0,0,0" Target="{Binding ElementName=Filter}"/>
            <ComboBox x:Name="Filter" Height="34" Margin="0" VerticalContentAlignment="Center" IsEnabled="False" SelectedIndex="0" SelectionChanged="SelectFilter">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Со свободными битами"/>
                <ComboBoxItem Content="С конфликтами"/>
            </ComboBox>
        </WrapPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,3,0,3"/>
                    <Style.Triggers>
                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>
            <TextBlock x:Name="AddressRanges" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="Status" Text="Выберите проект или откройте файл .cfgproj." FontSize="15"
                       TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>

        </StackPanel>
        <TabControl>
            <TabItem Header="Карта битов">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="2,2,0,10" Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap" Text="Выберите бит, чтобы увидеть его назначения."/>
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="14,10" CornerRadius="8"
                            Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock x:Name="DetailTitle" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText}" Text="Назначения" Margin="0,0,0,5"/>
                            <ListBox x:Name="OwnerList" Height="112" FontSize="14" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Объекты выбранного адреса"
                                     MouseDoubleClick="EditSelectedOwner" KeyDown="OwnerKeyDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <ItemsControl x:Name="GridRows" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" Margin="2,5,2,0" Background="{DynamicResource BrushPanel}"
                                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,1,1,0">
                                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Items[0].Grouped}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="SelectBit" MouseDoubleClick="EditBit" Margin="2" Padding="2,7" Content="{Binding Caption}"
                                                        ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Detail}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#E7F2E9"/>
                                                            <Setter Property="Foreground" Value="#163320"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Surface" CornerRadius="5" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#475569"/></Trigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#164F89"/></Trigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter TargetName="Surface" Property="BorderBrush" Value="#164F89"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Занят"><Setter Property="Background" Value="#C9E2FA"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Конфликт"><Setter Property="Background" Value="#FFBEAE"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="IssuesTab" Header="Нераспознанные адреса"><ListBox x:Name="Issues"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>

