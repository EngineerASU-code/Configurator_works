<Window x:Class="Configurator.BuiltInEngineerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учётная запись Инженер-ПНР"
        Width="520" Height="390" MinWidth="480" MinHeight="360"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="26" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Встроенный пользователь Инженер-ПНР" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Margin="0,10,0,16" Text="Задайте пароль, чтобы включить фиксированную учётную запись. Её логин и роль нельзя изменить." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
        <TextBlock Grid.Row="2" Text="Новый пароль (не менее 5 символов)" Margin="0,0,0,5" Foreground="{DynamicResource BrushText}"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Height="42" Padding="9,0" VerticalContentAlignment="Center"/>
        <TextBlock Grid.Row="4" Text="Повторите пароль" Margin="0,12,0,5" Foreground="{DynamicResource BrushText}"/>
        <Grid Grid.Row="5">
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="42" Padding="9,0" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="ErrorText" Grid.Row="1" Margin="0,8,0,0" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap"/>
        </Grid>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="100" Height="42" Style="{StaticResource BtnSecondary}" Click="Cancel_Click"/>
            <Button Content="Сохранить и включить" Width="180" Height="42" Margin="8,0,0,0" Style="{StaticResource BtnPrimary}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
