<UserControl x:Class="Configurator.MatrixCatalogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="MatrixOptionCaption">
            <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel Visibility="Collapsed" DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="PLC" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                <TextBox x:Name="PlcInput" Width="88" Height="38" Padding="8,2" VerticalContentAlignment="Center" KeyDown="PlcInput_KeyDown"/>
                <Button Width="190" Height="36" Padding="4,0" x:Name="LoadPlcButton" Content="Загрузить" Margin="6,0,12,0" Style="{StaticResource BtnSecondary}" Click="LoadPlc_Click"/>
            </StackPanel>
            <TextBlock x:Name="ContextText" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushTextSecondary}"/>
        </DockPanel>

        <TabControl x:Name="MatrixTabs" Grid.Row="1" Margin="0,0,0,8"
                    IsEnabled="{Binding IsEnabled, ElementName=SectionBox}" SelectionChanged="MatrixTabs_SelectionChanged">
            <TabItem Header="Matrix" Tag="matrix-list"/>
            <TabItem Header="Commands" Tag="matrix-command-list">
                <TabControl x:Name="CommandTabs">
                    <TabItem Header="Список команд" Tag="matrix-command-list"/>
                    <TabItem Header="Карта команд" Tag="matrix-commands"/>
                </TabControl>
            </TabItem>
            <TabItem Header="Device List" Tag="matrix-device-list-type">
                <TabControl x:Name="DeviceListTabs">
                    <TabItem Header="Типы списков" Tag="matrix-device-list-type"/>
                    <TabItem Header="Варианты списка" Tag="matrix-device-list"/>
                </TabControl>
            </TabItem>
            <TabItem Header="Devices" Tag="matrix-devices"/>
        </TabControl>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Visibility="Collapsed" Text="Раздел" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSecondary}"/>
            <ComboBox x:Name="SectionBox" Visibility="Collapsed" Width="270" Height="38" Padding="8,2" ItemTemplate="{StaticResource MatrixOptionCaption}" SelectedValuePath="Id" SelectionChanged="SectionBox_SelectionChanged"/>
            <TextBlock x:Name="MatrixRecordLabel" Text="Матрица" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{DynamicResource BrushTextSecondary}" Visibility="Collapsed"/>
            <ComboBox x:Name="MatrixRecordBox" Width="270" Height="38" Padding="8,2" ItemTemplate="{StaticResource MatrixOptionCaption}" SelectedValuePath="Record" SelectionChanged="MatrixRecordBox_SelectionChanged" Visibility="Collapsed"/>
            <TextBlock x:Name="DeviceGroupLabel" Text="Вариант устройств" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{DynamicResource BrushTextSecondary}" Visibility="Collapsed"/>
            <ComboBox x:Name="DeviceGroupBox" Width="220" Height="38" Padding="8,2" ItemTemplate="{StaticResource MatrixOptionCaption}" SelectedValuePath="Number" SelectionChanged="DeviceGroupBox_SelectionChanged" Visibility="Collapsed" ToolTip="Вариант задаёт привязки устройств к позициям. Сетка команд общая для всех вариантов матрицы."/>
            <TextBlock x:Name="PositionLabel" Text="Позиция" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{DynamicResource BrushTextSecondary}" Visibility="Collapsed"/>
            <ComboBox x:Name="PositionBox" Width="185" Height="38" Padding="8,2" ItemTemplate="{StaticResource MatrixOptionCaption}" SelectedValuePath="Position" SelectionChanged="PositionBox_SelectionChanged" Visibility="Collapsed"/>
            <TextBlock x:Name="DevicePLCLabel" Text="PLC объекта" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{DynamicResource BrushTextSecondary}" Visibility="Collapsed"/>
            <ComboBox x:Name="DevicePLCBox" Width="90" Height="38" Padding="8,2" ItemTemplate="{StaticResource MatrixOptionCaption}" SelectedValuePath="Number" SelectionChanged="DevicePLCBox_SelectionChanged" Visibility="Collapsed"/>
            <TextBlock x:Name="DeviceObjectLabel" Text="Объект" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{DynamicResource BrushTextSecondary}" Visibility="Collapsed"/>
            <ComboBox x:Name="DeviceObjectBox" Width="250" Height="38" Padding="8,2" ItemTemplate="{StaticResource MatrixOptionCaption}" SelectionChanged="DeviceObjectBox_SelectionChanged" Visibility="Collapsed"/>
        </WrapPanel>

        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <Button Width="190" Height="36" Padding="4,0" x:Name="AddButton" Content="＋ Добавить" Style="{StaticResource BtnPrimary}" Click="Add_Click"/>
            <Button Width="190" Height="36" Padding="4,0" x:Name="DeleteButton" Content="Удалить строку" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Click="Delete_Click"/>
            <Button Width="190" Height="36" Padding="4,0" x:Name="SaveButton" Content="Сохранить" Margin="8,0,0,0" Style="{StaticResource BtnSaveObject}" Click="Save_Click"/>
            <Button Width="190" Height="36" Padding="4,0" x:Name="RefreshButton" Content="Обновить" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Click="Refresh_Click"/>
            <Button Width="190" Height="36" Padding="4,0" x:Name="ExportButton" Content="Экспорт AWL" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Click="ExportAwl_Click"/>
        </WrapPanel>

        <Grid Grid.Row="4">
            <DataGrid x:Name="RowsGrid" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow" AutoGeneratingColumn="RowsGrid_AutoGeneratingColumn"
                      BeginningEdit="RowsGrid_BeginningEdit" RowEditEnding="RowsGrid_RowEditEnding" SelectionChanged="RowsGrid_SelectionChanged"
                      HeadersVisibility="Column" EnableRowVirtualization="True"/>
            <TextBlock x:Name="EmptyStateText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="560" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
    </Grid>
</UserControl>
