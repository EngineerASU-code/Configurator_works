<Window x:Class="Configurator.MultiObjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить несколько объектов" Width="960" Height="520" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BrushBase}" Foreground="{DynamicResource BrushText}"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="BatchCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="BatchCellEditor" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrushBase}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="Массовое добавление объектов" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock x:Name="InputHint" Text="Укажите название каждого объекта."
                       Margin="0,4,0,0" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
            <Border x:Name="ValidationPanel" Visibility="Collapsed" Background="#12B42318"
                    BorderBrush="#55B42318" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,10,0,0">
                <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ValidationText" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10"
                Padding="8" ClipToBounds="True">
            <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                      IsReadOnly="False" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BrushGridLine}"
                      VerticalGridLinesBrush="{DynamicResource BrushGridLine}"
                      CanUserResizeColumns="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                      RowHeaderWidth="0" RowHeight="42" ColumnHeaderHeight="36"
                      EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="NameColumn" Header="Название объекта" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource BatchCellText}" EditingElementStyle="{StaticResource BatchCellEditor}"
                                        Width="3*" MinWidth="150"/>
                    <DataGridTemplateColumn x:Name="PlcColumn" Header="PLC" Width="2*" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding PlcOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding PlcKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Height="32" Padding="8,3" MinWidth="0" MaxDropDownHeight="300"
                                          ToolTip="Выберите PLC для этой строки">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="RecordColumn" Header="Record" Binding="{Binding Record, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource BatchCellText}" EditingElementStyle="{StaticResource BatchCellEditor}"
                                        Width="100" MinWidth="75"/>
                    <DataGridTemplateColumn Header="Действие" Width="100" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Удалить" Tag="{Binding}" Click="RemoveRow_Click" Padding="8,4"
                                        MinHeight="32" Style="{StaticResource BtnSecondary}"
                                        ToolTip="Удалить строку"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnAddRow" Grid.Column="0" HorizontalAlignment="Left"
                    Content="＋  Добавить строку" Style="{StaticResource BtnSecondary}"
                    Click="AddRow_Click" Height="40" Padding="14,6"
                    ToolTip="Добавить строку (Insert)"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="Отмена" Click="Cancel_Click" Height="40"
                        MinWidth="110" Margin="0,0,8,0" Style="{StaticResource BtnSecondary}" IsCancel="True"/>
                <Button IsDefault="True" x:Name="BtnAccept" Content="Добавить объекты" Click="Accept_Click" Height="40"
                        MinWidth="180" Style="{StaticResource BtnPrimary}"
                        ToolTip="Проверить и добавить подготовленные строки (Ctrl+Enter)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
