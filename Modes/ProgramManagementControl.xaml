<UserControl x:Class="Configurator.ProgramManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900" MinHeight="560">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Программы, последовательности и шаги"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock Text="PLC" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="PlcInput" Width="100" Margin="0,0,12,0" />
            <TextBlock Text="Класс программы" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="ClassInput" Width="120" Margin="0,0,12,0" />
            <Button Content="Загрузить" Padding="14,5" Click="LoadButton_Click" />
            <Button Content="Отменить правки" Margin="8,0,0,0" Padding="12,5" Click="DiscardChangesButton_Click" />
            <TextBlock x:Name="ContextText" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Программы" Margin="0,0,4,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="＋ Программа" Margin="4" Padding="12,4" Click="AddProgramButton_Click" />
                        <Button Content="Удалить" Margin="4" Padding="12,4" Click="DeleteProgramButton_Click" />
                        <Button Content="Сохранить" Tag="programs" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                    </StackPanel>
                    <DataGrid x:Name="ProgramsGrid" Tag="programs" AutoGenerateColumns="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              SelectionUnit="FullRow" IsReadOnly="False" SelectionChanged="ProgramsGrid_SelectionChanged"
                              AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Последовательности" Margin="4,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="＋ Последовательность" Margin="4" Padding="12,4" Click="AddSequenceButton_Click" />
                        <Button Content="Удалить" Margin="4" Padding="12,4" Click="DeleteSequenceButton_Click" />
                        <Button Content="Сохранить" Tag="sequences" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                    </StackPanel>
                    <DataGrid x:Name="SequencesGrid" Tag="sequences" AutoGenerateColumns="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              SelectionUnit="FullRow" IsReadOnly="False" SelectionChanged="SequencesGrid_SelectionChanged"
                              AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Шаги выбранной последовательности" Margin="4,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="＋ Шаг из справочника" Margin="4" Padding="12,4" Click="AddStepButton_Click" />
                        <Button Content="Сохранить шаг" Tag="steps" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                    </StackPanel>
                    <DataGrid x:Name="StepsGrid" Tag="steps" AutoGenerateColumns="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              SelectionUnit="FullRow" IsReadOnly="False"
                              AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                </DockPanel>
            </GroupBox>
        </Grid>

        <TabControl Grid.Row="3" Margin="0,10,0,8">
            <TabItem Header="Переходы">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Удалить выбранный шаг из последовательности" Margin="4" Padding="12,4" Click="DeleteStepButton_Click" />
                        <Button Content="Сохранить переход" Tag="transitions" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                    </StackPanel>
                    <DataGrid x:Name="TransitionsGrid" Tag="transitions" AutoGenerateColumns="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              SelectionUnit="FullRow" IsReadOnly="False" SelectionChanged="TransitionsGrid_SelectionChanged"
                              AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Параметры программы">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="Сохранить параметр" Tag="programParams"
                            HorizontalAlignment="Right" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                    <DataGrid x:Name="ProgramParamsGrid" Tag="programParams" AutoGenerateColumns="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              SelectionUnit="FullRow" IsReadOnly="False"
                              AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Параметры шага">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                        <TextBlock Text="Номер шага" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="StepNumberInput" Width="90" Text="1" />
                        <Button Content="Показать" Margin="8,0,0,0" Padding="12,3" Click="LoadStepParamsButton_Click" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Content="Сохранить параметр" Tag="stepParams"
                            HorizontalAlignment="Right" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                    <DataGrid x:Name="StepParamsGrid" Tag="stepParams" AutoGenerateColumns="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              SelectionUnit="FullRow" IsReadOnly="False"
                              AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                </DockPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="4" x:Name="StatusText" Text="Выберите PLC и класс, затем загрузите программы."
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
