<UserControl x:Class="Configurator.ProgramManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900" MinHeight="560">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Программы, последовательности и шаги"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock Text="PLC" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="PlcInput" Width="100" Margin="0,0,12,0" />
            <TextBlock Text="Класс программы" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="ClassInput" Width="120" Margin="0,0,12,0" />
            <Button x:Name="LoadButton" Content="Загрузить" Padding="14,5" Click="LoadButton_Click" />
            <Button x:Name="DiscardChangesButton" Content="Отменить правки" Margin="8,0,0,0" Padding="12,5" Click="DiscardChangesButton_Click" />
            <TextBlock x:Name="ContextText" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.34*" MinWidth="245" />
                <ColumnDefinition Width="0.66*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Структура программы" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Раскройте программу и выберите ветку для настройки."
                               TextWrapping="Wrap" Margin="6,4,6,8" Foreground="Gray" />
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="AddProgramButton" Content="＋ Программа" Margin="2" Padding="8,4" Click="AddProgramButton_Click" />
                        <Button x:Name="AddSequenceButton" Content="＋ Последовательность" Margin="2" Padding="8,4" Click="AddSequenceButton_Click" />
                        <Button x:Name="AddStepButton" Content="＋ Шаг" ToolTip="Добавить существующий шаг в выбранную последовательность." Margin="2" Padding="8,4" Click="AddStepButton_Click" />
                        <Button x:Name="DeleteProgramButton" Content="Удалить программу" Margin="2" Padding="8,4" Click="DeleteProgramButton_Click" />
                        <Button x:Name="DeleteSequenceButton" Content="Удалить последовательность" Margin="2" Padding="8,4" Click="DeleteSequenceButton_Click" />
                        <Button x:Name="DeleteStepButton" Content="Удалить вхождение" ToolTip="Удалить выбранный шаг из последовательности." Margin="2" Padding="8,4" Click="DeleteStepButton_Click" />
                    </WrapPanel>
                    <TreeView x:Name="ProgramTreeView" SelectedItemChanged="ProgramTreeView_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </GroupBox>

            <TabControl x:Name="DetailsTabs" Grid.Column="1" Margin="6,0,0,0">
                <TabItem x:Name="ProgramDetailsTab" Header="Программа">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.1*" />
                            <RowDefinition Height="0.9*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Поля программы" Margin="0,0,0,5">
                            <DockPanel>
                                <Button x:Name="SaveProgramsButton" DockPanel.Dock="Bottom" Content="Сохранить программу"
                                        Tag="programs" HorizontalAlignment="Right" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                                <DataGrid x:Name="ProgramsGrid" Tag="programs" AutoGenerateColumns="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                          SelectionUnit="FullRow" IsReadOnly="False" SelectionChanged="ProgramsGrid_SelectionChanged"
                                          RowEditEnding="EntityGrid_RowEditEnding" AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Параметры программы" Margin="0,5,0,0">
                            <DockPanel>
                                <Button x:Name="SaveProgramParamsButton" DockPanel.Dock="Bottom" Content="Сохранить параметр"
                                        Tag="programParams" HorizontalAlignment="Right" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                                <DataGrid x:Name="ProgramParamsGrid" Tag="programParams" AutoGenerateColumns="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                          SelectionUnit="FullRow" IsReadOnly="False" SelectionChanged="DetailGrid_SelectionChanged"
                                          RowEditEnding="EntityGrid_RowEditEnding" AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>
                <TabItem x:Name="SequenceDetailsTab" Header="Последовательность">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.8*" />
                            <RowDefinition Height="1.2*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Поля последовательности" Margin="0,0,0,5">
                            <DockPanel>
                                <Button x:Name="SaveSequencesButton" DockPanel.Dock="Bottom" Content="Сохранить последовательность"
                                        Tag="sequences" HorizontalAlignment="Right" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                                <DataGrid x:Name="SequencesGrid" Tag="sequences" AutoGenerateColumns="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                          SelectionUnit="FullRow" IsReadOnly="False" SelectionChanged="SequencesGrid_SelectionChanged"
                                          RowEditEnding="EntityGrid_RowEditEnding" AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Вхождения шагов и переходы" Margin="0,5,0,0">
                            <DockPanel>
                                <Button x:Name="SaveTransitionsButton" DockPanel.Dock="Bottom" Content="Сохранить переход"
                                        Tag="transitions" HorizontalAlignment="Right" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                                <DataGrid x:Name="TransitionsGrid" Tag="transitions" AutoGenerateColumns="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                          SelectionUnit="FullRow" IsReadOnly="False" SelectionChanged="TransitionsGrid_SelectionChanged"
                                          RowEditEnding="EntityGrid_RowEditEnding" AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>
                <TabItem x:Name="StepDetailsTab" Header="Шаг и параметры">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.1*" />
                            <RowDefinition Height="0.9*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Поля справочника шага" Margin="0,0,0,5">
                            <DockPanel>
                                <Button x:Name="SaveStepsButton" DockPanel.Dock="Bottom" Content="Сохранить шаг"
                                        Tag="steps" HorizontalAlignment="Right" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                                <DataGrid x:Name="StepsGrid" Tag="steps" AutoGenerateColumns="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                          SelectionUnit="FullRow" IsReadOnly="False" SelectionChanged="StepsGrid_SelectionChanged"
                                          RowEditEnding="EntityGrid_RowEditEnding" AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Параметры выбранного вхождения" Margin="0,5,0,0">
                            <DockPanel>
                                <Button x:Name="SaveStepParamsButton" DockPanel.Dock="Bottom" Content="Сохранить параметр"
                                        Tag="stepParams" HorizontalAlignment="Right" Margin="4" Padding="12,4" Click="SaveEntityButton_Click" />
                                <DataGrid x:Name="StepParamsGrid" Tag="stepParams" AutoGenerateColumns="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                          SelectionUnit="FullRow" IsReadOnly="False" SelectionChanged="DetailGrid_SelectionChanged"
                                          RowEditEnding="EntityGrid_RowEditEnding" AutoGeneratingColumn="EntityGrid_AutoGeneratingColumn" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Выберите PLC и класс, затем загрузите программы."
                   TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
