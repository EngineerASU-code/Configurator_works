<Window x:Class="Configurator.FieldRelationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Связь поля" Width="620" Height="360" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="Выберите список, из которого поле будет брать допустимые значения." Margin="0,4,0,14" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Таблица связи" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbTable" Grid.Row="1" Height="32" SelectionChanged="Table_SelectionChanged"/>
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ключ" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbKey" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Отображаемое поле" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbDisplay" Height="32"/>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="3" x:Name="TxtStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Очистить связь" Style="{StaticResource BtnSecondary}" Width="125" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="Отмена" Style="{StaticResource BtnSecondary}" Width="95" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Width="105" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
