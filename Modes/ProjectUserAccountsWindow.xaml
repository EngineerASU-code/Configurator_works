<Window x:Class="Configurator.ProjectUserAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учётные записи Offline-проекта" Width="900" Height="620"
        MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="20" UseLayoutRounding="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Учётные записи проекта" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="Аккаунты хранятся только в текущем .cfgproj. Пароли сохраняются в виде защищённых хешей." Margin="0,5,0,0" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="ProjectUsersList" Margin="0,0,0,10" SelectionChanged="ProjectUsersList_SelectionChanged"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="＋ Добавить" Width="130" Height="42" MinHeight="42" Style="{StaticResource BtnPrimary}" Click="AddUser_Click"/>
                    <Button x:Name="DeleteUserButton" Content="Удалить" Width="105" Height="42" MinHeight="42" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Click="DeleteUser_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" Padding="18" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Аккаунт проекта" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                    <TextBlock Grid.Row="1" Text="Логин" Margin="0,12,0,5" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox x:Name="UserNameBox" Grid.Row="2" Height="42" MinHeight="42" VerticalContentAlignment="Center" Padding="10,0"/>
                    <TextBlock Grid.Row="3" Text="Имя в списке входа" Margin="0,10,0,5" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBox x:Name="DisplayNameBox" Grid.Row="4" Height="42" MinHeight="42" VerticalContentAlignment="Center" Padding="10,0"/>
                    <Grid Grid.Row="5" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Роль" Margin="0,0,0,5" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <ComboBox x:Name="RoleBox" Height="42" MinHeight="42" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="PasswordLabel" Text="Пароль" Margin="0,0,0,5" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <PasswordBox x:Name="PasswordBox" Height="42" MinHeight="42" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="EnabledBox" Grid.Row="6" Content="Учётная запись включена" Margin="0,12,0,0" Foreground="{DynamicResource BrushText}" VerticalAlignment="Top"/>
                    <Button Grid.Row="7" Content="Сохранить учётную запись" Height="44" MinHeight="44" HorizontalAlignment="Right" Margin="0,14,0,0" Style="{StaticResource BtnPrimary}" Click="SaveUser_Click"/>
                </Grid>
            </Border>
        </Grid>
        <Button Grid.Row="2" Content="Закрыть" Width="110" Height="42" MinHeight="42" HorizontalAlignment="Right" Margin="0,14,0,0" Style="{StaticResource BtnSecondary}" Click="Close_Click"/>
    </Grid>
</Window>
