<Window x:Class="Configurator.AccessSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка доступа Configurator"
        Width="560" Height="520" MinWidth="560" MinHeight="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="28" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Настройка административного доступа" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Margin="0,10,0,18" Text="До завершения настройки рабочий интерфейс недоступен. Новый пароль администратора должен содержать не менее 12 символов." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
        <TextBlock x:Name="CurrentPasswordLabel" Grid.Row="2" Text="Текущий пароль администратора" Margin="0,0,0,5" Foreground="{DynamicResource BrushText}"/>
        <PasswordBox x:Name="CurrentPasswordBox" Grid.Row="3" Height="42" Padding="9,0" VerticalContentAlignment="Center"/>
        <TextBlock Grid.Row="4" Margin="0,14,0,5" Text="Новый пароль администратора" Foreground="{DynamicResource BrushText}"/>
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="5" Height="42" Padding="9,0" VerticalContentAlignment="Center"/>
        <TextBlock Grid.Row="6" Margin="0,14,0,5" Text="Повторите новый пароль" Foreground="{DynamicResource BrushText}"/>
        <Grid Grid.Row="7" Margin="0,0,0,10">
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="42" Padding="9,0" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="ErrorText" Grid.Row="1" Margin="0,8,0,0" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap"/>
        </Grid>
        <Button Grid.Row="8" Content="Сохранить пароль и продолжить" Width="250" Height="44" HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}" Click="Save_Click"/>
    </Grid>
</Window>
