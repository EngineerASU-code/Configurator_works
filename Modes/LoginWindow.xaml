<Window x:Class="Configurator.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в Configurator"
        Width="500" SizeToContent="Height" MinWidth="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="30" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Configurator" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
        <TextBlock Grid.Row="1" Text="Вход пользователя" Margin="0,5,0,22" Foreground="{DynamicResource BrushTextSecondary}"/>
        <TextBlock Grid.Row="2" Text="Пользователь" Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
        <ComboBox x:Name="UserBox" Grid.Row="3" Height="46" MinHeight="46" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" DisplayMemberPath="DisplayName" SelectedValuePath="UserName"/>
        <Grid Grid.Row="4" Margin="0,16,0,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="PasswordLabel" Text="Пароль администратора" Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Height="46" MinHeight="46" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" KeyDown="PasswordBox_KeyDown"/>
            <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,8,0,0" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap"/>
        </Grid>
        <Button x:Name="LoginButton" IsDefault="True" Grid.Row="5" Content="Войти" Width="120" Height="44" MinHeight="44" HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}" Click="Login_Click"/>
    </Grid>
</Window>
