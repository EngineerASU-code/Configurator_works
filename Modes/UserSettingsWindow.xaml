<Window x:Class="Configurator.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки пользователей" Width="1260" Height="860" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <Grid Margin="18" UseLayoutRounding="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Настройки пользователей" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,14"/>
        <TabControl Grid.Row="1" Margin="0,0,0,6">
            <TabItem Header="Пользователи">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="UsersList" Grid.Column="0" MinHeight="300" DisplayMemberPath="DisplayName"
                             SelectedValuePath="UserName" SelectionChanged="UsersList_SelectionChanged"/>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Учётная запись" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Grid.Row="1" Text="Логин" Margin="0,14,0,5" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBox x:Name="UserNameBox" Grid.Row="2" IsReadOnly="True" Height="46" MinHeight="46" VerticalContentAlignment="Center" Padding="10,0" FontSize="13"/>
                            <TextBlock Grid.Row="3" Text="Отображаемое имя" Margin="0,12,0,5" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBox x:Name="DisplayNameBox" Grid.Row="4" Height="46" MinHeight="46" VerticalContentAlignment="Center" Padding="10,0" FontSize="13"/>
                            <Grid Grid.Row="5" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Роль" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="RoleBox" Height="46" MinHeight="46" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" Margin="0,0,0,14"/>
                                    <TextBlock Text="Новый пароль" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                    <PasswordBox x:Name="PasswordBox" Height="46" MinHeight="46" VerticalContentAlignment="Center" Padding="10,0" FontSize="13"/>
                                    <CheckBox x:Name="EnabledBox" Content="Учётная запись включена" Margin="0,14,0,0" Foreground="{DynamicResource BrushText}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Пароль вводится только при изменении. Минимум 5 символов. Отключённую учётную запись можно включить только после задания нового пароля. Пароли хранятся в виде хэшей." Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="14,0,0,0" VerticalAlignment="Top"/>
                            </Grid>
                            <Button Grid.Row="6" Content="Сохранить пользователя" Width="220" Height="44" MinHeight="44" HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource BtnPrimary}" Click="SaveUser_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="RolesTab" Header="Роли">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ListBox x:Name="RolesList" MinHeight="300" Margin="0,0,0,10" SelectionChanged="RolesList_SelectionChanged"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Content="＋ Добавить" Width="130" Height="42" MinHeight="42" Style="{StaticResource BtnPrimary}" Click="AddRole_Click"/>
                            <Button Content="Удалить" Width="110" Height="42" MinHeight="42" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Click="DeleteRole_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Права роли" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                            <TextBox x:Name="RoleNameBox" Grid.Row="1" Height="46" MinHeight="46" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" Margin="0,12,0,14"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PermissionsHost"/></ScrollViewer>
                            <Button Grid.Row="3" Content="Сохранить роль" Width="180" Height="44" MinHeight="44" HorizontalAlignment="Right" Margin="0,14,0,0" Style="{StaticResource BtnPrimary}" Click="SaveRole_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <Button Grid.Row="2" Content="Закрыть" Width="110" Height="42" MinHeight="42" HorizontalAlignment="Right" Margin="0,12,0,0" Style="{StaticResource BtnSecondary}" Click="Close_Click"/>
    </Grid>
</Window>
