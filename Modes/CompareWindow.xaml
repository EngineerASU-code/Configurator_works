<Window x:Class="Configurator.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение проектов"
        Width="1720" Height="1000" MinWidth="1000" MinHeight="650" WindowState="Maximized"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BrushBase}"
        Foreground="{DynamicResource BrushText}">
    <Window.Resources>
        <Style x:Key="CompareResultRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsObjectHeader}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompareCellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="SideGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
            <EventSetter Event="SelectionChanged" Handler="SideSelectionChanged"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="RowStyle" Value="{StaticResource CompareResultRowStyle}"/>
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <EventSetter Event="Loaded" Handler="SideGrid_Loaded"/>
            <EventSetter Event="ScrollViewer.ScrollChanged" Handler="SideGrid_ScrollChanged"/>
        </Style>
        <GroupStyle x:Key="ObjectGroup">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                    <ContentPresenter/>
                                    <ItemsPresenter/>
                                </StackPanel>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Border Height="28" Padding="10,0" Background="{DynamicResource BrushPanel}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </Window.Resources>

    <Grid Margin="10" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,6">
            <Button x:Name="CompareButton" DockPanel.Dock="Right" Content="Сравнить" Click="CompareButton_Click"
                    Style="{StaticResource BtnPrimary}" MinWidth="106" Margin="8,0,0,0"/>
            <ComboBox x:Name="SectionBox" DockPanel.Dock="Left" Width="180"
                      AutomationProperties.Name="Раздел сравнения" SelectionChanged="SectionBox_SelectionChanged"/>
            <Border DockPanel.Dock="Left" Width="1" Height="24" Margin="12,0" Background="{DynamicResource BrushBorder}"/>
            <TextBlock DockPanel.Dock="Left" Text="Сценарий" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ScenarioBox" DockPanel.Dock="Left" Width="175" SelectionChanged="ScenarioBox_SelectionChanged"/>
            <Button x:Name="FlipButton" DockPanel.Dock="Left" Content="⇄  Поменять стороны" Margin="8,0,0,0"
                    Click="FlipButton_Click" Style="{StaticResource BtnSecondary}"/>
            <Border DockPanel.Dock="Left" Width="1" Height="24" Margin="12,0" Background="{DynamicResource BrushBorder}"/>
            <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Right" Width="60" Height="4"
                         IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="ProgressText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource BrushBorder}" Background="{DynamicResource BrushPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                        <TextBlock Text="ПРОЕКТ A" FontWeight="Bold" FontSize="12"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="OnlineDatabaseA" Grid.ColumnSpan="3"
                                  SelectionChanged="OnlineDatabase_SelectionChanged"/>
                        <TextBox x:Name="OfflinePathA" IsReadOnly="True" Visibility="Collapsed"
                                 VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <Button x:Name="OpenOfflineA" Grid.Column="2" Content="Выбрать файл…"
                                AutomationProperties.Name="Выбрать офлайн-проект A"
                                Visibility="Collapsed" Click="OpenOfflineA_Click"
                                Style="{StaticResource BtnSecondary}"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource BrushBorder}" Background="{DynamicResource BrushPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                        <TextBlock Text="ПРОЕКТ B" FontWeight="Bold" FontSize="12"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="OnlineDatabaseB" Grid.ColumnSpan="3"
                                  SelectionChanged="OnlineDatabase_SelectionChanged"/>
                        <TextBox x:Name="OfflinePathB" IsReadOnly="True" Visibility="Collapsed"
                                 VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <Button x:Name="OpenOfflineB" Grid.Column="2" Content="Выбрать файл…"
                                AutomationProperties.Name="Выбрать офлайн-проект B"
                                Visibility="Collapsed" Click="OpenOfflineB_Click"
                                Style="{StaticResource BtnSecondary}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderA" Text="A · Проект" FontSize="16" FontWeight="SemiBold" Margin="4,4,4,8"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="HeaderB" Grid.Column="2" Text="B · Проект" FontSize="16" FontWeight="SemiBold" Margin="4,4,4,8"
                       TextTrimming="CharacterEllipsis"/>
            <DataGrid x:Name="LeftGrid" Grid.Row="1" Style="{StaticResource SideGrid}"
                      AutomationProperties.Name="Таблица проекта A">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource CompareResultRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecordA}" Value="True">
                                <Setter Property="Background" Value="#382F9E63"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasRecordA}" Value="False">
                                <Setter Property="Background" Value="#38DA4949"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Difference.Status}" Value="OnlyA"><Setter Property="Background" Value="#382F9E63"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="OnlyB"><Setter Property="Background" Value="#38DA4949"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="Ambiguous"><Setter Property="Background" Value="#80E98224"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="NotComparable"><Setter Property="Background" Value="#80E98224"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="Error"><Setter Property="Background" Value="#60DA4949"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="Changed">
                                <Setter Property="Background" Value="#55E5AD21"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Difference.Status}" Value="KeyConflict">
                                <Setter Property="Background" Value="#80E98224"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.GroupStyle><StaticResource ResourceKey="ObjectGroup"/></DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Элемент" Binding="{Binding Title}" Width="7*" ElementStyle="{StaticResource CompareCellText}"/>
                    <DataGridTextColumn Header="Значение A" Binding="{Binding A}" Width="3*" ElementStyle="{StaticResource CompareCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                <Button x:Name="CopyToB" Content="→" Click="TransferAtoB_Click" FontSize="20" Margin="0,0,0,8"
                        AutomationProperties.Name="Перенести из A в B"
                        IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Выберите различие"/>
                <Button x:Name="CopyToA" Content="←" Click="TransferBtoA_Click" FontSize="20"
                        AutomationProperties.Name="Перенести из B в A"
                        IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Выберите различие"/>
            </StackPanel>
            <DataGrid x:Name="RightGrid" Grid.Row="1" Grid.Column="2" Style="{StaticResource SideGrid}"
                      ItemsSource="{Binding ItemsSource, ElementName=LeftGrid}"
                      AutomationProperties.Name="Таблица проекта B">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource CompareResultRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecordB}" Value="True">
                                <Setter Property="Background" Value="#382F9E63"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasRecordB}" Value="False">
                                <Setter Property="Background" Value="#38DA4949"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Difference.Status}" Value="OnlyA"><Setter Property="Background" Value="#38DA4949"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="OnlyB"><Setter Property="Background" Value="#382F9E63"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="Ambiguous"><Setter Property="Background" Value="#80E98224"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="NotComparable"><Setter Property="Background" Value="#80E98224"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="Error"><Setter Property="Background" Value="#60DA4949"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Difference.Status}" Value="Changed">
                                <Setter Property="Background" Value="#55E5AD21"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Difference.Status}" Value="KeyConflict">
                                <Setter Property="Background" Value="#80E98224"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.GroupStyle><StaticResource ResourceKey="ObjectGroup"/></DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Элемент" Binding="{Binding Title}" Width="7*" ElementStyle="{StaticResource CompareCellText}"/>
                    <DataGridTextColumn Header="Значение B" Binding="{Binding B}" Width="3*" ElementStyle="{StaticResource CompareCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</Window>
