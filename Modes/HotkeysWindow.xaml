<Window x:Class="Configurator.HotkeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Горячие клавиши" Width="720" Height="590" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Горячие клавиши" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
        <Border Grid.Row="1" Margin="0,14,0,14" Padding="14" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel TextElement.Foreground="{DynamicResource BrushText}">
                    <TextBlock Text="Проект и журнал" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,6"/>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Ctrl + Z"/>
                        <TextBlock TextWrapping="Wrap" Text="Отменить последнее доступное действие проекта через журнал операций."/>
                    </DockPanel>
                    <TextBlock Text="Таблица данных" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,6"/>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Ctrl + N"/>
                        <TextBlock TextWrapping="Wrap" Text="Добавить строку таблицы или объект выбранного класса."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Ctrl + C"/>
                        <TextBlock TextWrapping="Wrap" Text="Скопировать выделенные строки в порядке видимых столбцов."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Ctrl + V"/>
                        <TextBlock TextWrapping="Wrap" Text="Вставить данные из буфера. Неполный набор столбцов вставляется с текущего столбца."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Delete"/>
                        <TextBlock TextWrapping="Wrap" Text="Удалить выделенные строки."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Ctrl + D"/>
                        <TextBlock TextWrapping="Wrap" Text="Дублировать выбранную строку."/>
                    </DockPanel>
                    <TextBlock Text="Объекты и программы" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,6"/>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Ctrl + C / Ctrl + V"/>
                        <TextBlock TextWrapping="Wrap" Text="В списке объектов класса — скопировать выбранный объект или вставить его копию."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Ctrl + S"/>
                        <TextBlock TextWrapping="Wrap" Text="Сохранить изменения в редакторе. В окне «Изменить строку» также закрывает форму после успешной проверки."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Delete"/>
                        <TextBlock TextWrapping="Wrap" Text="В списках объектов, программ, последовательностей, шагов, параметров и матриц — вызвать удаление выбранного элемента."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Enter"/>
                        <TextBlock TextWrapping="Wrap" Text="В диалоге — выполнить основное действие. После Delete клавиша Enter подтверждает удаление. В результатах поиска — выбрать элемент."/>
                    </DockPanel>
                    <TextBlock Text="Массовый ввод объектов" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,6"/>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Insert"/>
                        <TextBlock TextWrapping="Wrap" Text="Добавить строку."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Delete"/>
                        <TextBlock TextWrapping="Wrap" Text="Удалить выбранную строку вне редактирования текста."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Ctrl + Enter"/>
                        <TextBlock TextWrapping="Wrap" Text="Принять введённые строки."/>
                    </DockPanel>
                    <DockPanel Margin="0,2,8,4">
                        <TextBlock Width="132" FontWeight="SemiBold" Text="Esc"/>
                        <TextBlock TextWrapping="Wrap" Text="Закрыть раскрытый список, отменить редактирование или закрыть окно."/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Button IsDefault="True" Grid.Row="2" Content="Закрыть" Width="100" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
