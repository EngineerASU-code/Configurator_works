<Window x:Class="Configurator.GraphRelationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Логическая связь" Width="620" Height="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBase}" ResizeMode="NoResize">
    <Window.Resources>
        <DataTemplate x:Key="ShortNameTemplate"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}"/></DataTemplate>
        <DataTemplate x:Key="ColumnTemplate"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Логическая связь" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
        <TextBlock Grid.Row="1" Text="Связь хранится в конфигураторе и не создаёт FOREIGN KEY в БД." Margin="0,4,0,14" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Из таблицы" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                <ComboBox x:Name="SourceTableCombo" ItemTemplate="{StaticResource ShortNameTemplate}" Margin="0,3,0,0" TextSearch.TextPath="Name" SelectionChanged="SourceTableCombo_SelectionChanged" ToolTip="Полное имя таблицы"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="В таблицу" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                <ComboBox x:Name="TargetTableCombo" ItemTemplate="{StaticResource ShortNameTemplate}" Margin="0,3,0,0" TextSearch.TextPath="Name" SelectionChanged="TargetTableCombo_SelectionChanged" ToolTip="Полное имя таблицы"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Поле источника" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                <ComboBox x:Name="SourceColumnCombo" ItemTemplate="{StaticResource ColumnTemplate}" Margin="0,3,0,0" TextSearch.TextPath="Name"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Поле назначения" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                <ComboBox x:Name="TargetColumnCombo" ItemTemplate="{StaticResource ColumnTemplate}" Margin="0,3,0,0" TextSearch.TextPath="Name"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Описание правила" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
            <TextBox x:Name="RuleText" Margin="0,3,0,0" MinHeight="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Width="95" Height="32" Margin="0,0,7,0" Style="{StaticResource BtnSecondary}" Click="Cancel_Click"/>
            <Button IsDefault="True" x:Name="SaveButton" Content="Добавить" Width="105" Height="32" Style="{StaticResource BtnPrimary}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
