<Window x:Class="Configurator.LookupGenerationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки справочников" Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Генерация и привязка справочников" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="Правила хранятся внутри текущего .cfgproj. Активное правило имеет приоритет над автоматическим определением." Margin="0,3,0,0" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
            <CheckBox x:Name="ChkAutomaticDiscovery" Content="Разрешить автоматическое обнаружение для правил без ручной привязки" Margin="0,8,0,0" Foreground="{DynamicResource BrushText}"/>
        </StackPanel>
        <DataGrid x:Name="RulesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                  Background="{DynamicResource BrushPanel}" Foreground="{DynamicResource BrushText}" BorderBrush="{DynamicResource BrushBorder}"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                <DataGridTextColumn Header="Класс" Binding="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Исходная таблица" Binding="{Binding SourceTable, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Исходное поле" Binding="{Binding SourceField, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="Таблица справочника" Binding="{Binding LookupTable, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Поле ключа" Binding="{Binding KeyField, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="Поле отображения" Binding="{Binding DisplayField, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="＋ Правило" Width="105" Margin="0,0,7,0" Click="Add_Click" Style="{StaticResource BtnPrimary}"/>
                <Button Content="Удалить" Width="90" Margin="0,0,7,0" Click="Delete_Click" Style="{StaticResource BtnSecondary}"/>
                <Button Content="Импорт JSON…" Width="120" Margin="0,0,7,0" Click="Import_Click" Style="{StaticResource BtnSecondary}"/>
                <Button Content="Экспорт JSON…" Width="120" Click="Export_Click" Style="{StaticResource BtnSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Отмена" Width="100" Margin="0,0,7,0" Click="Cancel_Click" Style="{StaticResource BtnSecondary}"/>
                <Button Content="Сохранить в .cfgproj" Width="170" Click="Save_Click" Style="{StaticResource BtnPrimary}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
