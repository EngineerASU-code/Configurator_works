<UserControl x:Class="Configurator.ProjectModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Configurator"
             Background="{DynamicResource BrushBase}"
             PreviewKeyDown="ProjectModeView_PreviewKeyDown">
    <Grid Margin="12,10,12,8">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="ObjectActionsToolbar" Grid.Row="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,8,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="BtnLookupWarnings" Grid.Column="0" Content="⚠" Width="34" Height="34" Padding="0" Margin="0,0,6,0" FontSize="14" Style="{StaticResource BtnSecondary}" Visibility="Collapsed" Click="LookupWarnings_Click"/>
                    <Border x:Name="ActionFeedbackIcon" Grid.Column="1" Width="19" Height="19" CornerRadius="10" Background="#228B45" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"><TextBlock x:Name="ActionFeedbackCheck" Text="✓" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="ActionFeedbackText" Grid.Column="2" Text="Выберите действие" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnObjectSearch" Content="⌕" Width="34" Height="34" Margin="2,0,4,0" Padding="0" FontSize="18" Style="{StaticResource BtnSecondary}" Click="ObjectSearch_Click" ToolTip="Открыть окно поиска" IsEnabled="False"/>
                    <Button x:Name="BtnObjectFilter" Width="34" Height="34" Margin="4,0,8,0" Padding="0" Style="{StaticResource BtnSecondary}" Click="ObjectFilterWindow_Click" ToolTip="Фильтр по PLC и Area" IsEnabled="False">
                        <Grid Width="18" Height="18">
                            <Path x:Name="FilterIcon" Data="M2,3 L22,3 L14,11 L14,19 L10,21 L10,11 Z" Stretch="Uniform" Fill="{DynamicResource BrushTextSecondary}"/>
                            <Ellipse x:Name="FilterActiveBadge" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource BrushAccent}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Border Width="1" Height="24" Background="{DynamicResource BrushBorder}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnNewObject" Content="＋  Добавить" IsEnabled="False" Width="120" Height="34" FontSize="12" Margin="2,0,4,0" Padding="12,0" Style="{StaticResource BtnPrimary}" Click="NewObject_Click" ToolTip="Добавить новый объект или значение конфигурации"/>
                    <Button x:Name="BtnNewObjectsBatch" IsEnabled="False" Content="＋  Несколько" Width="120" Height="34" FontSize="12" Margin="4,0,4,0" Padding="12,0" Style="{StaticResource BtnSecondary}" Click="NewObjectsBatch_Click" ToolTip="Создать несколько объектов, указав только имена"/>
                    <Button x:Name="BtnConfigDelete" IsEnabled="False" Content="Удалить" Width="120" Height="34" FontSize="12" Margin="4,0,4,0" Padding="12,0" Style="{StaticResource BtnPrimary}" Click="DeleteConfigurationValue_Click"/>
                    <Button x:Name="BtnDuplicate" IsEnabled="False" Content="Дублировать" Style="{StaticResource BtnSecondary}" Width="120" Height="34" FontSize="12" Margin="4,0,4,0" Padding="12,0" Click="DuplicateObject_Click"/>
                    <Button x:Name="BtnDelete" IsEnabled="False" Content="Удалить" Style="{StaticResource BtnPrimary}" Width="120" Height="34" FontSize="12" Margin="4,0,4,0" Padding="12,0" Click="DeleteObject_Click"/>
                    <Button x:Name="BtnSave" IsEnabled="False" Content="Сохранить" Style="{StaticResource BtnPrimary}" Width="120" Height="34" FontSize="12" Margin="4,0,2,0" Padding="12,0" Click="SaveObject_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="300" MaxWidth="380"/><ColumnDefinition Width="10"/>
                <ColumnDefinition Width="390" MinWidth="350" MaxWidth="460"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Конфигурация" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="2,2,2,8"/>
                    <ListBox x:Name="ConfigurationList" BorderThickness="0" Background="Transparent" Padding="1" SelectionChanged="ConfigurationList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ConfigItemBorder" Padding="10,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}" Background="{DynamicResource BrushBase}">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushText}"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                        <Setter TargetName="ConfigItemBorder" Property="Height" Value="12"/>
                                        <Setter TargetName="ConfigItemBorder" Property="Background" Value="Transparent"/>
                                        <Setter TargetName="ConfigItemBorder" Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                        <Setter TargetName="ConfigItemBorder" Property="BorderThickness" Value="0,1,0,0"/>
                                        <Setter TargetName="ConfigItemBorder" Property="Padding" Value="0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter TargetName="ConfigItemBorder" Property="Background" Value="{DynamicResource BrushBase}"/>
                                        <Setter TargetName="ConfigItemBorder" Property="Margin" Value="0,0,0,0"/>
                                        <Setter TargetName="ConfigItemBorder" Property="Padding" Value="10,8"/>
                                        <Setter TargetName="ConfigItemBorder" Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="ConfigItemBorder" Property="Background" Value="{DynamicResource BrushHover}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="ConfigItemBorder" Property="Background" Value="{DynamicResource BrushSelected}"/>
                                        <Setter TargetName="ConfigItemBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                        <Setter TargetName="ConfigItemBorder" Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="ObjectListPanel" Grid.Column="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="2,2,2,8">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtClassTitle" Text="Объекты" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock x:Name="TxtObjectCount" Grid.Column="1" Text="" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="8,0"/>
                        </Grid>
                    </StackPanel>
                    <ListBox x:Name="ObjectList" SelectionMode="Extended" BorderThickness="0" Background="Transparent" Padding="1" SelectionChanged="ObjectList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border x:Name="ObjectCard" CornerRadius="8" Padding="10,7" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="{DynamicResource BrushBase}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"><Setter TargetName="ObjectCard" Property="Background" Value="{DynamicResource BrushSelected}"/><Setter TargetName="ObjectCard" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/></DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"><Setter TargetName="ObjectCard" Property="Background" Value="{DynamicResource BrushHover}"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="ObjectDetailsPanel" Grid.Column="4" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="138"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,5,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtObjectName" Text="Выберите объект" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <TextBlock x:Name="TxtObjectMeta" Text="Выберите класс и объект слева" Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/><TextBlock x:Name="TxtObjectContext" Text="" Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="9" Padding="8" Margin="5,0,0,0">
                            <Grid>
                                <Image x:Name="ImgObjectTypePreview" Width="122" Height="102" Margin="0,0,0,12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock x:Name="TxtPreviewGlyph" Text="OBJ" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}"/>
                                <TextBlock x:Name="TxtPreviewClass" Text="" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="2,9,2,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Информация объекта" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><TextBlock Text="Связанные поля — списки" Grid.Column="1" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/></Grid>
                    <ScrollViewer x:Name="ObjectEditorScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="ObjectEditor"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions></Grid></ScrollViewer>
                </Grid>
            </Border>

            <Grid x:Name="ProgramToolsHost" Grid.Column="2" Grid.ColumnSpan="3" Visibility="Collapsed">
                <TabControl x:Name="ProgramToolsTabs">
                    <TabItem Header="Program / Step">
                        <local:ProgramManagementControl x:Name="ProgramManagementEditor" />
                    </TabItem>
                    <TabItem Header="Рецепты и параметры">
                        <local:ProgramSupportControl x:Name="ProgramSupportEditor" />
                    </TabItem>
                </TabControl>
                <local:MatrixCatalogControl x:Name="MatrixCatalogEditor" Visibility="Collapsed" />
            </Grid>
        </Grid>
        <!-- Hidden compatibility filters retained for existing data/filter helpers. They are no longer shown in Mode 3 UI. -->
        <StackPanel Visibility="Collapsed"><ComboBox x:Name="CmbPlcFilter" SelectionChanged="ObjectFilter_SelectionChanged"/><ComboBox x:Name="CmbAreaFilter" SelectionChanged="ObjectFilter_SelectionChanged"/></StackPanel>
        <!-- Legacy selector retained only as a hidden compatibility bridge for existing selection handlers. -->
        <ListBox x:Name="ClassList" Visibility="Collapsed" Width="0" Height="0" SelectionChanged="ClassList_SelectionChanged"/>
        <Border x:Name="ProjectUnavailableBanner" Grid.Row="0" Panel.ZIndex="50" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="18,10,18,0"
                Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="10" Padding="16,10" MaxWidth="760">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Online-проект не готов" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                    <TextBlock x:Name="ProjectUnavailableMessage" Text="Выберите подключённую базу данных, чтобы загрузить объекты проекта."
                               Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Открыть / выбрать проект…" Height="36" Padding="12,0"
                        VerticalAlignment="Center" Click="SelectProject_Click" Style="{StaticResource BtnPrimary}"/>
            </Grid>
        </Border>
        <DockPanel Grid.Row="2" Visibility="Collapsed" Margin="3,7,3,0"><TextBlock x:Name="TxtStatus" Text="Выберите класс" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis"/></DockPanel>
        <TextBlock x:Name="TxtProjectDatabase" Text="не выбран" Visibility="Collapsed"/>
    </Grid>
</UserControl>
