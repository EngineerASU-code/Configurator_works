<Window x:Class="Configurator.AssemblyEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="780" Height="570" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}" Foreground="{DynamicResource BrushText}">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border x:Name="RootFields" Background="{DynamicResource BrushPanel}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="Имя нового объекта"/><TextBox x:Name="NewName" Margin="0,4" Padding="6"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="Record программы"/><TextBox x:Name="NewRecord" Margin="0,4" Padding="6"/></StackPanel>
    </Grid>
   </Border>
   <TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10"/>
   <StackPanel x:Name="Choices"/>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button IsCancel="True" Content="Отмена" Style="{StaticResource BtnSecondary}" Padding="14,5" Margin="0,0,8,0"/>
   <Button x:Name="Apply" IsDefault="True" Style="{StaticResource BtnPrimary}" Padding="14,5" Click="ApplyClick"/>
  </StackPanel><TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel>
 </Grid>
</Window>
