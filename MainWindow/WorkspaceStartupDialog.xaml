<Window x:Class="Configurator.WorkspaceStartupDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Configurator"
 Title="GASS Configurator" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
 Background="#F7F7F2" Foreground="#292545" FontFamily="Segoe UI">
 <Grid>
  <local:EngineeringIntro x:Name="Intro"/>
  <Grid x:Name="Welcome" Visibility="Collapsed" Margin="28">
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="6,0,16,0">
    <TextBlock Text="GASS" FontSize="22" Foreground="#116B73" FontWeight="Bold"/>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="Configurator" FontSize="46" Foreground="#1C2130" FontWeight="SemiBold"/></Viewbox>
    <Button x:Name="Start" Content="Начать работу" Width="158" Height="44" HorizontalAlignment="Left" Margin="0,26,0,0" Click="Start_Click" Background="#34335E" Foreground="#F7F7F2" FontWeight="SemiBold"/>
   </StackPanel>
   <Viewbox Grid.Column="1" Margin="4" Stretch="Uniform">
    <Canvas Width="650" Height="310">
     <Rectangle Canvas.Left="24" Canvas.Top="43" Width="219" Height="8" Fill="#ADD9D8"/><TextBlock Canvas.Left="24" Canvas.Top="19" Text="Рабочий проект" FontSize="26" FontWeight="SemiBold" Foreground="#292545"/>
     <Path Stroke="#36868B" StrokeThickness="2" Data="M172,130 H200 V185 H230 M172,240 H200 V185 M385,185 H416 V130 H450 M416,185 V240 H450"/>
     <Path Fill="#36868B" Data="M230,185 l-8,-4 v8 Z M450,130 l-8,-4 v8 Z M450,240 l-8,-4 v8 Z"/>
       <Border Canvas.Left="24" Canvas.Top="95" Width="148" Height="70" Background="#FFFFFF" BorderBrush="#ACA9BD" BorderThickness="1" CornerRadius="3" Padding="12,8">
        <StackPanel VerticalAlignment="Center"><TextBlock Text="SQL Server" Foreground="#252439" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Online" Foreground="#49616A" FontSize="13" Margin="0,3,0,0"/></StackPanel>
       </Border>
       <Border Canvas.Left="24" Canvas.Top="205" Width="148" Height="70" Background="#FFFFFF" BorderBrush="#ACA9BD" BorderThickness="1" CornerRadius="3" Padding="12,8">
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Файл .cfgproj" Foreground="#252439" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Offline" Foreground="#49616A" FontSize="13" Margin="0,3,0,0"/></StackPanel>
       </Border>
       <Border Canvas.Left="230" Canvas.Top="150" Width="155" Height="70" Background="#C0E3DF" BorderBrush="#277F80" BorderThickness="1" CornerRadius="3" Padding="12,8">
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Конфигуратор" Foreground="#252439" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Данные проекта" Foreground="#49616A" FontSize="13" Margin="0,3,0,0"/></StackPanel>
       </Border>
       <Border Canvas.Left="450" Canvas.Top="95" Width="178" Height="70" Background="#FFFFFF" BorderBrush="#ACA9BD" BorderThickness="1" CornerRadius="3" Padding="12,8">
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Структура БД" Foreground="#252439" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Таблицы и связи" Foreground="#49616A" FontSize="13" Margin="0,3,0,0"/></StackPanel>
       </Border>
       <Border Canvas.Left="450" Canvas.Top="205" Width="178" Height="70" Background="#FFFFFF" BorderBrush="#ACA9BD" BorderThickness="1" CornerRadius="3" Padding="12,8">
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Объекты проекта" Foreground="#252439" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Типы и экземпляры" Foreground="#49616A" FontSize="13" Margin="0,3,0,0"/></StackPanel>
       </Border>
    </Canvas>
   </Viewbox>
  </Grid>
 </Grid>
</Window>