<Window x:Class="Configurator.WorkspaceStartupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurator · рабочая среда" Width="760" Height="500" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BrushBase}" Foreground="{DynamicResource BrushText}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Добро пожаловать в Configurator" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="Выберите источник данных: SQL Server или сохранённый локальный проект" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Height="1" Background="{DynamicResource BrushBorder}" Margin="0,12,0,18"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="ONLINE" FontSize="12" FontWeight="Bold" Foreground="#26845B"/><TextBlock Text="Актуальная база данных" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    <TextBlock Grid.Row="1" Text="Подключение к SQL Server и работа с выбранной базой в реальном времени." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,12,0,14"/>
                    <Button Grid.Row="2" Content="Перейти в Online" Click="Online_Click" Height="40" FontWeight="SemiBold"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="OFFLINE" FontSize="12" FontWeight="Bold" Foreground="#3979C3"/><TextBlock Text="Локальный проект" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    <TextBlock Grid.Row="1" Text="Открыть сохранённый файл .cfgproj и работать с локальной копией без записи в Online-БД." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,12,0,14"/>
                    <Button Grid.Row="2" Content="Открыть локальный проект…" Click="OpenProject_Click" Height="40" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,20,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Для Offline выберите файл .cfgproj. Для Online потребуется авторизация; отмена входа не закрывает приложение." Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>