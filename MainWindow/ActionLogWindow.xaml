<Window x:Class="Configurator.ActionLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал операций" Width="1380" Height="760" MinWidth="1080" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Журнал операций" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="История изменений текущего проекта" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            <TextBlock x:Name="TxtCount" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="6">
            <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" HorizontalAlignment="Stretch" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{Binding TimestampUtc, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"/>
                                    <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding User, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding UserRole, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="7,3" CornerRadius="5" Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding OperationKindDisplay, Mode=OneWay}" Foreground="{DynamicResource BrushText}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel Grid.Column="3" Grid.Row="0">
                                    <TextBlock Text="{Binding Description, Mode=OneWay}" Foreground="{DynamicResource BrushText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,3,0,0">
                                        <Run Text="{Binding ProjectType, Mode=OneWay}"/><Run Text=" · режим "/><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" · проект: "/><Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Database, Mode=OneWay, StringFormat=БД: {0}}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                                    <TextBlock Text="{Binding EntityIdentity, Mode=OneWay, StringFormat=Элемент: {0}}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="4" Grid.Row="0" Content="Восстановить" Width="108" MinWidth="108" Height="34" Style="{StaticResource BtnSecondary}" IsEnabled="{Binding CanRestore, Mode=OneWay}" Tag="{Binding}" Click="Restore_Click" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" ItemsSource="{Binding Changes}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12">
                                                <Run Text="{Binding TableName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding KindDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ChangeSummary, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Закрыть" Style="{StaticResource BtnSecondary}" Width="100" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
