<Window x:Class="Configurator.PasteConflictsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конфликты Record" Width="900" Height="550" MinWidth="650" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}"
        Foreground="{DynamicResource BrushText}" FontSize="14">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BrushPanel}" Padding="22,16"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Конфликты при вставке" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"
                           Text="Отметьте строки для замены. Чтобы добавить строку под другим ключом, заполните поле «Новый Record»."/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="22,12" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Отменить вставку" IsCancel="True"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="Change" Content="Изменить Record" Click="Apply_Click" Margin="0,0,8,0"/>
                    <Button IsDefault="True" x:Name="Replace" Content="Заменить запись" Style="{StaticResource BtnPrimary}" Click="Apply_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                   Margin="22,4,22,12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive"/>
        <DockPanel DockPanel.Dock="Top" Margin="22,14,22,10">
            <CheckBox Content="Отметить все" x:Name="All" Click="All_Click" VerticalAlignment="Center"
                      Foreground="{DynamicResource BrushText}"/>
            <TextBlock x:Name="Status" HorizontalAlignment="Right" Foreground="{DynamicResource BrushTextSecondary}"/>
        </DockPanel>
        <ListBox x:Name="Rows" Margin="16,0,16,10" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="6,0,6,7"/></ControlTemplate></Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14,10" CornerRadius="8" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=Mark}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="Mark" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{Binding Number, StringFormat=Отметить строку {0}}" VerticalAlignment="Center" Click="Row_Click"/>
                            <StackPanel Grid.Column="1" Margin="10,0,18,0" VerticalAlignment="Center">
                                <WrapPanel>
                                    <TextBlock Text="{Binding Number, StringFormat=Строка {0}}" FontWeight="SemiBold" Margin="0,0,12,0" Foreground="{DynamicResource BrushText}"/>
                                    <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding KeyText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource BrushText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Новый Record" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewRecord, UpdateSourceTrigger=PropertyChanged}" Padding="8,4"
                                         IsEnabled="{Binding CanChangeRecord, RelativeSource={RelativeSource AncestorType=Window}}"
                                         AutomationProperties.Name="{Binding Number, StringFormat=Новый Record для строки {0}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
